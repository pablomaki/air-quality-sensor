// To get started, press Ctrl+Space to bring up the completion menu and view the available nodes.

// You can also use the buttons in the sidebar to perform actions on nodes.
// Actions currently available include:

// * Enabling / disabling the node
// * Adding the bus to a bus
// * Removing the node
// * Connecting ADC channels

// For more help, browse the DeviceTree documentation at https: //docs.zephyrproject.org/latest/guides/dts/index.html
// You can also visit the nRF DeviceTree extension documentation at https: //docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension

/ {
	// XIAO BLE has no physical buttons. NCS's Matter common board helper
	// (nrf/samples/matter/common/src/board/board_config.h) unconditionally
	// computes NUMBER_OF_BUTTONS from DT_PATH(buttons) at compile time, so an
	// (empty) buttons node is needed for it to compile - Board::Init() itself
	// already no-ops correctly on boards without CONFIG_DK_LIBRARY (no real
	// button behavior is implied by this node).
	leds {
		compatible = "gpio-leds";

		led2: led_2 {
			gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		led1: led_1 {
			gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		led0: led_0 {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button switch 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	sht4x: sht4x@44 {
		status = "disabled";
		compatible = "sensirion,sht4x";
		reg = <0x44>;
		repeatability = <2>;
	};
	sgp40: sgp40@59 {
		    status = "disabled";
		    compatible = "sensirion,sgp40";
		    reg = <0x59>;
	};

	bmp390: bmp390@77 {
		status = "disabled";
		compatible = "bosch,bmp390";
		reg = <0x77>;
		odr = "12.5";
		osr-press = <8>;
		osr-temp = <1>;
		iir-filter = <1>;
	};

	scd41: scd41@62 {
		status = "disabled";
		compatible = "sensirion,scd41";
		reg = <0x62>;
		mode = <0>;
	};
	bme680: bme680@77 {
		status = "disabled";
		compatible = "bosch,bme680";
		reg = <0x77>;
	};
};

&qspi {
	// Do not change the pins during sleep otherwise a 6mA consumption happens
	pinctrl-1 = <&qspi_default>;
};

/ {
	aliases {
		spi-flash0 = &p25q16h;
	};
};

&spi3 {
	status = "disabled";
};

&uart0 {
	status = "disabled";
};

&pwm0 {
	status = "disabled";
};

&gpio0 {
	status = "okay";
};


