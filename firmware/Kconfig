# Main Kconfig file for air quality sensor

mainmenu "Air Quality Sensor Configuration"

source "Kconfig.zephyr"

# Matter over Thread support (see src/matter/) - the only supported
# communication stack, enabled via CONFIG_CHIP=y in prj.conf.
if NET_L2_OPENTHREAD

choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
    default OPENTHREAD_NORDIC_LIBRARY_MTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
    default OPENTHREAD_MTD
endchoice

endif # NET_L2_OPENTHREAD

source "${ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR}/config/nrfconnect/chip-module/Kconfig.features"
source "${ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR}/config/nrfconnect/chip-module/Kconfig.defaults"
source "${ZEPHYR_NRF_MODULE_DIR}/samples/matter/common/src/Kconfig"

menu "Application Configuration"

menu "Timing Configuration"

config SAMPLE_INTERVAL_MS
    int "Sensor sampling interval (milliseconds)"
    range 1000 3600000
    default 5000
    help
      How often every enabled sensor is read. This is a property of the sensors
      rather than of reporting: it also sets the sampling interval handed to the
      Sensirion gas index algorithm, which is specified for 1 s and tested up to
      10 s, and it is bounded below at 1000 ms so that the conversion to whole
      seconds stays meaningful.

config REPORT_INTERVAL_MS
    int "Matter reporting interval (milliseconds)"
    range 1000 3600000
    default 60000
    help
      How often the Matter cluster attributes are refreshed from the buffered
      samples. Together with SAMPLE_INTERVAL_MS this also sets how many samples
      are averaged into each reported value: one reporting period's worth, so
      every sample contributes to exactly one report. Note that when a controller
      actually receives values is governed by its own subscription min/max
      intervals, not by this value.


config SENSOR_WARMUP_TIME_MS
    int "Sensor warmup time (milliseconds)"
    default 5000
    help
      Warmup time for sensors in milliseconds. Required by SGP40 for consistent readings.

endmenu

menu "Peripheral Configuration"

config ENABLE_EVENT_LED
    bool "Enable event LED"
    default y
    help
      Enable or disable the event LED.

# Each sensor is gated on its devicetree node, so the board overlay is the single
# source of truth for which parts exist. Adding the node enables both the Zephyr
# driver (which defaults from the same symbol) and the application support; these
# symbols only decide whether the application uses a part that is present.

config ENABLE_SHT4X
    bool "Enable SHT4X sensor"
    depends on DT_HAS_SENSIRION_SHT4X_ENABLED
    default y
    help
      Enable or disable SHT4X temperature/humidity sensor.

config ENABLE_SGP40
    bool "Enable SGP40 sensor"
    depends on DT_HAS_SENSIRION_SGP40_ENABLED
    default y
    help
      Enable or disable SGP40 VOC sensor.

config ENABLE_SCD4X
    bool "Enable SCD4X sensor"
    depends on DT_HAS_SENSIRION_SCD41_ENABLED || DT_HAS_SENSIRION_SCD40_ENABLED
    default y
    help
      Enable or disable SCD4X CO2 sensor.

config ENABLE_BMP390
    bool "Enable BMP390 sensor"
    depends on DT_HAS_BOSCH_BMP390_ENABLED
    default y
    help
      Enable or disable BMP390 pressure sensor.

config ENABLE_BME680
    bool "Enable BME680 sensor"
    depends on DT_HAS_BOSCH_BME680_ENABLED
    default y
    help
      Enable or disable BME680 sensor.

endmenu

menu "SCD4X Sensor Configuration"

config SCD4X_ALTITUDE
    int "Altitude (meters)"
    default 10
    help
      Altitude in meters. Only used if pressure is not provided by other sensors.

config SCD4X_TEMPERATURE_OFFSET
    int "Temperature offset (Celsius)"
    default 0
    help
      Temperature offset in Celsius. Reported temperature = measured - offset.
      SCD41 temperature readings are not currently used.

endmenu
endmenu