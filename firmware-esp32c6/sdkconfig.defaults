CONFIG_SUPPORT_MEDIA_FILE_MANAGEMENT_CLUSTER=n

# Application timing, as in the nRF prj.conf
CONFIG_SAMPLE_INTERVAL_MS=30000
CONFIG_REPORT_INTERVAL_MS=60000
CONFIG_ENABLE_EVENT_LED=y
